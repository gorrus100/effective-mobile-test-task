upstream backend-group {
    server backend:${APP_PORT};
}

server {
    listen ${PROXY_LISTEN_PORT};

    location / {
        proxy_pass http://backend-group;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Custom-Header "Effective Mobile Test Task";
    }
}
